{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "true",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "longitude.jbf.com"
        }
      ],
      "destination": "/claude1/v3/",
      "permanent": false
    }
  ]
}